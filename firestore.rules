rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> Remplace par TON e-mail de connexion admin (celui cree dans Authentication) <<<
    function isOwner() {
      return request.auth != null && request.auth.token.email == jbarondf65@gmail.com;
    }

    // Un cadeau est reservable s'il existe dans la liste (admin) ou dans la liste d'origine.
    function validGift(id) {
      return exists(/databases/$(database)/documents/gifts/$(id))
        || id in ["rituals-avent","sephora-avent","typology-avent","new-balance","pinceaux-sephora","diagnostic-peau"];
    }

    // Liste des cadeaux : lisible par tous, modifiable uniquement par toi.
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Public : seulement "ce cadeau est reserve". Aucun nom.
    match /reservations/{giftId} {
      allow read: if true;

      allow create: if validGift(giftId)
        && request.resource.data.keys().hasOnly(["reserved","at"])
        && request.resource.data.reserved == true
        && getAfter(/databases/$(database)/documents/private/$(giftId)).data.keys().hasOnly(["nameHash"]);

      allow delete: if validGift(giftId)
        && getAfter(/databases/$(database)/documents/private/$(giftId)).data.proof
           == get(/databases/$(database)/documents/private/$(giftId)).data.nameHash;

      allow update: if false;
    }

    // Prive : jamais lisible depuis le site.
    match /private/{giftId} {
      allow read: if false;
      allow delete: if false;

      allow create: if validGift(giftId)
        && request.resource.data.keys().hasOnly(["nameHash"])
        && request.resource.data.nameHash is string
        && request.resource.data.nameHash.size() == 64;

      allow update: if validGift(giftId) && (
        ( !exists(/databases/$(database)/documents/reservations/$(giftId))
          && request.resource.data.keys().hasOnly(["nameHash"])
          && request.resource.data.nameHash is string
          && request.resource.data.nameHash.size() == 64 )
        ||
        ( exists(/databases/$(database)/documents/reservations/$(giftId))
          && request.resource.data.keys().hasOnly(["nameHash","proof"])
          && request.resource.data.nameHash == resource.data.nameHash
          && request.resource.data.proof == resource.data.nameHash )
      );
    }
  }
}
